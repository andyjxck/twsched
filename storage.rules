rules_version = '2';

// Payslip PDFs: payslips/{staffUid}/{payslipId}.pdf
//   The owner and payroll users upload, replace and remove them; everyone else (managers too) can read only their own.
// Right to Work: rtw/{staffUid}/{docId}.{pdf|jpg|png|webp|heic}
//   Owner: upload, read, remove. Managers and staff: nothing (26 Oct: managers can't edit staff).
//   See functions/documents.js.
service firebase.storage {
  match /b/{bucket}/o {
    // No role while the account still has to choose its first password (claim pwChange, or the
    // server-only marker authGate/{uid} in Firestore, which also catches older tokens). See onboarding.js.
    function gateClear() {
      return request.auth.token.get('pwChange', false) != true
        // Two-step (functions/twoStep.js): mfa=true logins need a second factor on this sign-in.
        && (request.auth.token.get('mfa', false) != true
            || request.auth.token.get('firebase', {}).get('sign_in_second_factor', null) != null)
        && !firestore.exists(/databases/(default)/documents/authGate/$(request.auth.uid));
    }
    function role() { return request.auth != null && gateClear() ? request.auth.token.get('role', '') : ''; }
    function isManager() { return role() in ['owner', 'manager']; }
    function isStaff() { return role() in ['owner', 'manager', 'staff']; }
    function canPayroll() { return role() in ['owner', 'payroll']; }

    match /payslips/{staffId}/{fileName} {
      allow read: if canPayroll() || (isStaff() && request.auth.uid == staffId);
      allow create, update: if canPayroll()
        && fileName.matches('^[A-Za-z0-9_-]+\\.pdf$')
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if canPayroll();
    }

    function rtwExt(ct) {
      return ct == 'application/pdf' ? 'pdf' : ct == 'image/jpeg' ? 'jpg' : ct == 'image/png' ? 'png'
        : ct == 'image/webp' ? 'webp' : ct == 'image/heic' ? 'heic' : '';
    }
    match /rtw/{staffId}/{fileName} {
      allow read, delete: if role() == 'owner';
      // create only: an existing file can never be overwritten (not even by the owner; remove + add instead)
      allow create: if resource == null
        && role() == 'owner'
        && request.resource.contentType is string
        && rtwExt(request.resource.contentType) != ''
        && fileName.matches('^[A-Za-z0-9]{20}[.]' + rtwExt(request.resource.contentType) + '$')
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024;
      allow update: if false;
    }

    // ---------- Website editor photos (andyjxck/wshenley) ----------
    // Paste inside `match /b/{bucket}/o { ... }` in the Staff Hub's storage.rules (repo andyjxck/twsched).
    // Uses that file's role() helper. Same editors as firestore.rules: owners, plus Staff Hub accounts an
    // owner has approved in webEditors/{uid}.
    function isWebEditor() {
      return role() == 'owner'
        || (role() in ['manager', 'staff', 'payroll']
            && firestore.exists(/databases/(default)/documents/webEditors/$(request.auth.uid)));
    }
    function webPhoto(fileName) {
      return fileName.matches('^[a-f0-9]{24}\\.jpg$')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024;
    }
    // Draft uploads: private to editors until published.
    match /site-draft/{fileName} {
      allow read, delete: if isWebEditor();
      allow create: if resource == null && isWebEditor() && webPhoto(fileName);
      allow update: if false;
    }
    // Published photos: anyone can view them (they're on the live site); only editors add them, and a
    // published photo is never overwritten or removed from the page side, so the live site can't break.
    match /site/{fileName} {
      allow read: if true;
      allow create: if resource == null && isWebEditor() && webPhoto(fileName);
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
